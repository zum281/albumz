{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-theme",
    "core:window:allow-set-theme",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/Music/mp3/**", "app": true }]
    }
  ]
}
